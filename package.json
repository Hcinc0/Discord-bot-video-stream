{
  "name": "hcinco-discord-stream-dashboard",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "npm run check:node && node scripts/dev.mjs",
    "backend": "npm run dev --prefix server",
    "frontend": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "doctor": "npm run doctor --prefix server"
  }
}
